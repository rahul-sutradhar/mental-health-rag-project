# Mistral API configuration (required for chatbot, embeddings, and reranker)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_LLM_MODEL=mistral-llm-model

# FastAPI Session secret key (random secret string)
SESSION_SECRET=your_session_secret_key_here

# Production Database connection (optional: falls back to local SQLite if empty)
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=
